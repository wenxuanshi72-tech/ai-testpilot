# Safe development placeholders only. Copy to .env and replace locally.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-local-secret

SUT_DATABASE_URL=sqlite:///instance/sut.db
PLUGIN_DATABASE_URL=sqlite:///instance/plugin.db

SUT_BACKEND_URL=http://127.0.0.1:5001
SUT_FRONTEND_URL=http://127.0.0.1:5173
PLUGIN_BACKEND_URL=http://127.0.0.1:5002

DEEPSEEK_API_KEY=replace-with-your-local-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace-with-an-approved-model-id

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096

EVIDENCE_ROOT=artifacts/evidence
REPORT_ROOT=artifacts/reports
LOG_LEVEL=INFO
