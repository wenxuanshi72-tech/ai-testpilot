# Safe development placeholders only. Copy to .env and replace locally.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-local-secret

SUT_DATABASE_URL=sqlite:///instance/sut.db
SUT_SESSION_COOKIE_NAME=sut_session
SUT_SESSION_COOKIE_SECURE=false
SUT_SESSION_ABSOLUTE_SECONDS=28800
SUT_SESSION_IDLE_SECONDS=1800
SUT_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PLUGIN_DATABASE_URL=sqlite:///instance/plugin.db

SUT_BACKEND_URL=http://127.0.0.1:5001
SUT_FRONTEND_URL=http://127.0.0.1:5173
PLUGIN_BACKEND_URL=http://127.0.0.1:5002

DEEPSEEK_API_KEY=replace-with-your-local-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_RUN_MAX_OUTPUT_TOKENS=26624
TEST_GENERATION_MAX_CORRECTIONS_PER_BATCH=1
TEST_GENERATION_MAX_CORRECTIONS_PER_RUN=8
TEST_GENERATION_MAX_PROVIDER_RETRIES_PER_BATCH=3
TEST_GENERATION_MAX_PROVIDER_RETRIES_PER_RUN=15
TEST_GENERATION_MAX_TOTAL_PROVIDER_CALLS=40
TEST_GENERATION_MAX_COST_USD=0.25
TEST_GENERATION_MAX_COST_USD=0.10
PHASE5A_RECOVERY_SOURCE_RUN_ID=

EVIDENCE_ROOT=artifacts/evidence
REPORT_ROOT=artifacts/reports
LOG_LEVEL=INFO
