* text=auto eol=lf

# Windows PowerShell remains CRLF-friendly; PowerShell 7 also accepts it.
*.ps1 text eol=crlf

# POSIX shell scripts must retain LF.
*.sh text eol=lf

# Binary artifacts are never normalized or text-diffed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.sqlite binary
*.sqlite3 binary
*.db binary
