{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-testpilot.local/schemas/execution-snapshots/v1/execution_snapshot.schema.json",
  "title": "AI TestPilot immutable execution snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "executor_contract_version",
    "environment_id",
    "baseline_id",
    "case_id",
    "case_version",
    "approved_content_hash",
    "requirement_trace",
    "fixtures",
    "case"
  ],
  "properties": {
    "schema_version": { "const": "execution-snapshot@1.0.0" },
    "protocol_version": { "const": "unified-test-protocol@1.0.0" },
    "executor_contract_version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "environment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,79}$" },
    "baseline_id": { "type": "string", "pattern": "^FBL-[A-F0-9]{32}$" },
    "case_id": { "type": "string", "pattern": "^TC-[A-Z0-9-]+$" },
    "case_version": { "type": "integer", "minimum": 1 },
    "approved_content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirement_trace": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {
            "enum": [
              "create_isolated_anonymous_session",
              "create_authenticated_session"
            ]
          },
          "state": { "enum": ["expired", "revoked"] }
        }
      }
    },
    "case": { "type": "object" }
  }
}
