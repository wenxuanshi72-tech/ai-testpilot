{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-testpilot.local/schemas/requirements/v2/requirement_aggregate.schema.json",
  "title": "Validated source-grounded requirement aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prd_content_hash",
    "source_sections",
    "requirements",
    "total_reported_count",
    "aggregate_complete"
  ],
  "properties": {
    "schema_version": { "const": "requirements@2.0.0" },
    "prd_content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 },
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "requirement_batch.schema.json#/$defs/requirement"
      }
    },
    "total_reported_count": { "type": "integer", "minimum": 1, "maximum": 500 },
    "aggregate_complete": { "const": true }
  }
}
