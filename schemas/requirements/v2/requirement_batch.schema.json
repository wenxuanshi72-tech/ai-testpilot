{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-testpilot.local/schemas/requirements/v2/requirement_batch.schema.json",
  "title": "Source-grounded requirement extraction batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "source_sections",
    "requirements",
    "unsupported",
    "reported_count",
    "batch_complete"
  ],
  "properties": {
    "batch_id": { "type": "string", "pattern": "^BAT-[A-Z0-9-]{3,80}$" },
    "source_sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 },
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/unsupported" }
    },
    "reported_count": { "type": "integer", "minimum": 0, "maximum": 20 },
    "batch_complete": { "const": true }
  },
  "$defs": {
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_block_id", "statement", "reason"],
      "properties": {
        "source_block_id": {
          "type": ["string", "null"],
          "pattern": "^BLK-L[0-9]{4,}-L[0-9]{4,}-[A-F0-9]{10}$"
        },
        "statement": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "reason": { "const": "no_continuous_source" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "title",
        "description",
        "requirement_type",
        "source_section",
        "source_block_id",
        "source_excerpt",
        "acceptance_criteria",
        "business_rules",
        "actors",
        "priority",
        "risk_level",
        "ambiguities",
        "dependencies",
        "testability",
        "confidence",
        "tags"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^REQ-[A-Z0-9][A-Z0-9-]{2,79}$"
        },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "description": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "requirement_type": {
          "enum": ["functional", "business_rule", "security", "privacy", "quality"]
        },
        "source_section": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source_block_id": {
          "type": "string",
          "pattern": "^BLK-L[0-9]{4,}-L[0-9]{4,}-[A-F0-9]{10}$"
        },
        "source_excerpt": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": { "type": "string", "minLength": 5, "maxLength": 500 },
          "uniqueItems": true
        },
        "business_rules": {
          "type": "array",
          "maxItems": 15,
          "items": { "type": "string", "minLength": 3, "maxLength": 500 },
          "uniqueItems": true
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "uniqueItems": true
        },
        "priority": { "enum": ["must", "should", "could"] },
        "risk_level": { "enum": ["low", "medium", "high", "critical"] },
        "ambiguities": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 3, "maxLength": 500 },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]{2,79}$" },
          "uniqueItems": true
        },
        "testability": { "enum": ["testable", "partially_testable", "not_testable"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 },
          "uniqueItems": true
        }
      }
    }
  }
}
