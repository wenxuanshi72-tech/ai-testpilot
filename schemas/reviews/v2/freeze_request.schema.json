{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-testpilot.local/schemas/reviews/v2/freeze_request.schema.json",
  "title": "AI TestPilot portfolio MVP subset freeze request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frozen_by", "environment_id", "executor_contract_version"],
  "properties": {
    "schema_version": { "const": "test-case-review@2.0.0" },
    "frozen_by": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,79}$" },
    "environment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,79}$" },
    "executor_contract_version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
