{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-testpilot.local/schemas/test-cases/v1.1/manual_case_batch.schema.json",
  "$ref": "#/$defs/batch",
  "$defs": {
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "case_type",
        "cases",
        "unsupported",
        "reported_count",
        "batch_complete"
      ],
      "properties": {
        "batch_id": { "type": "string" },
        "case_type": { "const": "manual" },
        "cases": {
          "type": "array",
          "maxItems": 25,
          "items": { "$ref": "raw_test_case_candidate.schema.json" }
        },
        "unsupported": { "type": "array", "items": { "$ref": "#/$defs/unsupported" } },
        "reported_count": { "type": "integer", "minimum": 0, "maximum": 25 },
        "batch_complete": { "const": true }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "reason"],
      "properties": { "requirement_id": { "type": "string" }, "reason": { "type": "string" } }
    }
  }
}
