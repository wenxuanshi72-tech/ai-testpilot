{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-testpilot.local/schemas/test-intents/v2.1/api_intent_batch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["intents"],
  "properties": {
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "allOf": [
          { "$ref": "test_intent.schema.json" },
          {
            "properties": { "type_intent": { "$ref": "test_intent.schema.json#/$defs/api_intent" } }
          }
        ]
      }
    }
  }
}
